<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:padding="10dp"
        android:background="#E8EAF6"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_scope_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#FF6F00"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_float"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开启悬浮窗控制（需授权）" />

    <Button
        android:id="@+id/btn_lab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="检测实验室（隐身覆盖项/指纹清单）" />

    <Button
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="添加规则" />

    <Button
        android:id="@+id/btn_example"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="载入示例规则" />

    <Button
        android:id="@+id/btn_bili"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="载入 B站小游戏广告示例" />

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="清空规则" />

    <TextView
        android:id="@+id/tv_rules_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="已配置规则"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <ListView
        android:id="@+id/list_rules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
